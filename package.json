{
  "name": "regex-parity-repository",
  "version": "0.0.0",
  "private": true,
  "description": "The regex-parity repository: libraries in packages/, the specification in docs/, shared conformance cases and the evidence.",
  "license": "Apache-2.0",
  "workspaces": ["packages/js"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm test --workspace packages/js",
    "check": "node packages/js/src/cli.js check examples/rules.yaml",
    "cases": "node packages/js/src/cli.js cases conformance/rules.yaml conformance",
    "evidence": "bash test/evidence/run.sh"
  },
  "devDependencies": {
    "re2js": "2.8.6",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YauhenBichel/regex-parity.git"
  }
}
